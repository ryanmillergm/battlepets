NODE_ENV=production
HOST=0.0.0.0
PORT=3000
POSTGRES_DB=battlepets
POSTGRES_USER=battlepets
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://battlepets:replace-with-the-same-password@postgres:5432/battlepets
JWT_SECRET=replace-with-at-least-32-random-characters
REGISTRATION_MODE=closed
CHILD_ONLINE_ENABLED=false
CHAT_ENABLED=false
PAYMENTS_ENABLED=false
VOICE_ENABLED=false
SMTP_HOST=replace-with-mailtrap-smtp-host
SMTP_PORT=2525
SMTP_USER=replace-with-mailtrap-user
SMTP_PASS=replace-with-mailtrap-password
SMTP_FROM=Battle Pets <accounts@your-future-domain.example>
# OWNER_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
