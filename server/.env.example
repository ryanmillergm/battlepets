NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://battlepets:replace-with-the-same-local-password@localhost:5432/battlepets
JWT_SECRET=replace-with-at-least-32-random-characters
CHILD_ONLINE_ENABLED=false
CHAT_ENABLED=false
PAYMENTS_ENABLED=false
VOICE_ENABLED=false
REGISTRATION_MODE=invite
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
SMTP_HOST=127.0.0.1
